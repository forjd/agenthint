{
  "name": "agenthint",
  "version": "0.4.0",
  "description": "Detect AI agent runtimes and adapt CLI output.",
  "type": "module",
  "homepage": "https://github.com/forjd/agenthint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forjd/agenthint.git"
  },
  "bugs": {
    "url": "https://github.com/forjd/agenthint/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "agenthint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "generate:rules": "node scripts/generate-rules.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "rust:format": "cargo fmt --all",
    "rust:format:check": "cargo fmt --all --check",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "python:build": "python3 -m build",
    "python:test": "PYTHONPATH=python python3 -m unittest discover -s test -p 'python_test.py'",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run test && npm run rust:format:check && npm run rust:lint && npm run rust:test && npm run python:test",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "detection",
    "runtime"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
